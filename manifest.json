{
  "manifest_version": 3,
  "name": "UoB Smart Assistant",
  "version": "1.4.0",
  "description": "Unified student portal crawler and AI digest for Canvas, Outlook, MyUoB, Guild Societies, Library & Careers. Supports user-added custom websites.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.bham.ac.uk/*",
    "https://canvas.bham.ac.uk/*",
    "https://myuob.bham.ac.uk/*",
    "https://intranet.birmingham.ac.uk/*",
    "https://api.myday.cloud/*",
    "https://www.guildofstudents.com/*",
    "https://careersconnect.bham.ac.uk/*",
    "https://outlook.office.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://outlook.office365.com/*",
    "http://127.0.0.1:1234/*",
    "http://localhost:1234/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://canvas.bham.ac.uk/*"],
      "js": ["content-scripts/canvas.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://myuob.bham.ac.uk/*",
        "https://www.guildofstudents.com/*",
        "https://intranet.birmingham.ac.uk/*"
      ],
      "js": ["content-scripts/myuob.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["content-scripts/outlook.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "UoB Smart Assistant",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
